---
import "../../../src/styles/landing.css";
import "../styles/registry.css";
import SiteHead from "../../../src/components/SiteHead.astro";
import SiteHeader from "../../../src/components/SiteHeader.astro";
import SiteFooter from "../../../src/components/SiteFooter.astro";
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead title={`${title} · AutoSPECTRA`} description={description} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page-shell">
      <SiteHeader registry />
      <main class="registry" id="main"><slot /></main>
      <SiteFooter />
    </div>
  </body>
</html>
