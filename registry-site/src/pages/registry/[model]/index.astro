---
import Layout from "../../../components/RegistryLayout.astro";
import { models, modelAudits, auditURL } from "../../../lib/paper-registry";
export function getStaticPaths() {
  return models.map((model) => ({ params: { model: model.slug }, props: { model } }));
}
const { model } = Astro.props;
const runs = modelAudits(model.name);
---

<Layout title={`${model.name} investigations`} description={model.description}>
  <nav class="crumb" aria-label="Breadcrumb"><a href="/registry/">Audit registry</a><span aria-hidden="true">/</span><span>{model.name}</span></nav>
  <div class="registry-intro">
    <h1>{model.name}</h1>
    <p>{model.description}</p>
  </div>
  <div class="sectionline">
    <h2>Investigations</h2><span>{runs.length} records</span>
  </div>
  <ol class="runlist">
    {runs.map((audit) => (
      <li>
        <a href={auditURL(audit)}>
          <div class="run-meta">{audit.agent} · {audit.date}</div>
          <h2>{audit.title}</h2>
          <p>{audit.summary}</p>
          <span class="read-audit">Read the audit <span aria-hidden="true">→</span></span>
        </a>
      </li>
    ))}
  </ol>
</Layout>
