---
import Layout from "../../../components/RegistryLayout.astro";
import { investigations, statusNames } from "../../../lib/paper-registry";
export function getStaticPaths() {
  return investigations.map((audit) => ({
    params: { model: audit.model.toLowerCase(), audit: audit.id }, props: { audit },
  }));
}
const { audit } = Astro.props;
const modelSlug = audit.model.toLowerCase();
---

<Layout title={`${audit.model} · ${audit.title}`} description={audit.summary}>
  <nav class="crumb" aria-label="Breadcrumb">
    <a href="/registry/">Audit registry</a><span aria-hidden="true">/</span>
    <a href={`/registry/${modelSlug}/`}>{audit.model}</a>
  </nav>
  <div class="audit-body">
    <div class="registry-intro">
      <h1>{audit.title}</h1>
      <p>{audit.summary}</p>
      <div class="run-meta">{audit.agent} · {audit.date}</div>
    </div>
    <details class="audit-contents">
      <summary>Tests in this audit · {audit.axes.length}</summary>
      <ol>{audit.axes.map((axis, index) => <li><a href={`#axis-${index + 1}`}>{axis.name}</a></li>)}</ol>
    </details>
    <section aria-label="Tests and results">
      {audit.axes.map((axis, index) => (
        <article class="axis" id={`axis-${index + 1}`}>
          <div class="axis-heading">
            <h2>{axis.name}</h2>
            <span class={`decision ${axis.status}`}>{statusNames[axis.status]}</span>
          </div>
          <p class="explanation">{axis.explanation}</p>
          <h3>Result</h3>
          <p class="finding">{axis.result}</p>
          <details class="technical-details">
            <summary>Measurements, data and code</summary>
            <dl>
              <dt>Measurement</dt><dd>{axis.definition}</dd>
              <dt>Data</dt><dd>{axis.data}</dd>
              <dt>Analysis code</dt><dd>{axis.code}</dd>
            </dl>
            {axis.links?.length > 0 && <ul class="resources">{axis.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>}
          </details>
        </article>
      ))}
    </section>
    <section class="audit-files" aria-label="Audit files">
      {audit.date_note && <p class="basis">{audit.date_note}</p>}
      {audit.eligibility && <p class="basis">{audit.eligibility}</p>}
      {audit.code_provenance && <details class="technical-details"><summary>How the code was recovered</summary><p class="basis">{audit.code_provenance}</p></details>}
      <details class="technical-details">
        <summary>Source files and references · {audit.links.length}</summary>
        <ul class="resources">{audit.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
      </details>
      <div class="registry-downloads">
        <a href={`/registry/${modelSlug}/${audit.id}.json`}>Download JSON</a>
        <a href={`/registry/${modelSlug}/${audit.id}.md`}>Download Markdown</a>
      </div>
    </section>
  </div>
</Layout>
