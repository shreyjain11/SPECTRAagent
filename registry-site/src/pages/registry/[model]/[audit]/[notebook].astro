---
import { micromark } from "micromark";
import Layout from "../../../../components/RegistryLayout.astro";
import { investigations, auditURL, notebookFile } from "../../../../lib/paper-registry";
import { readNotebook, textOf } from "../../../../lib/notebook";

export function getStaticPaths() {
  return investigations.flatMap((audit) => audit.axes.map((axis, index) => ({
    params: { model: audit.model.toLowerCase(), audit: audit.id, notebook: `notebook-${index + 1}` },
    props: { audit, index },
  })));
}
const { audit, index } = Astro.props;
const axis = audit.axes[index];
const book = readNotebook(audit, index);
const info = book.metadata.spectra;
const visible = book.cells.filter((c) =>
  !["inputs", "readers", "intro", "result", "audit-script"].includes(c.metadata.spectra_role || "")
);
const script = book.cells.find((c) => c.metadata.spectra_role === "audit-script");
const scriptText = script ? textOf(script.source).split("\n").slice(3,-1).join("\n") : "";
---
<Layout title={`${axis.name} · Notebook`} description={axis.explanation}>
  <nav class="crumb" aria-label="Breadcrumb">
    <a href="/registry/">Audit registry</a><span aria-hidden="true">/</span>
    <a href={auditURL(audit) + "#axis-" + (index + 1)}>{audit.title}</a>
  </nav>
  <div class="notebook">
    <div class="notebook-intro">
      <div class="run-meta">Analysis notebook · {audit.model}</div>
      <h1>{axis.name}</h1>
      <p>{axis.explanation}</p>
      <div class="notebook-downloads">
        <a class="notebook-download" href={notebookFile(audit, index)} download>Download Jupyter notebook (.ipynb)</a>
        {info.bundleUrl && <a class="notebook-download" href={info.bundleUrl} download>Download notebooks, inputs and code</a>}
      </div>
      {info.bundleUrl && <p class="notebook-run-note">To run this notebook, extract the full {audit.model} bundle and follow its README.</p>}
    </div>
    <section class="notebook-measurement">
      <h2>Measurement</h2><p>{axis.definition}</p>
      <h2>Data</h2><p>{axis.data}</p>
      <h2>Audit result</h2><p>{axis.result}</p>
      {axis.review_note && <p class="notebook-note">Reproduction review: {axis.review_note}</p>}
    </section>
    {info.note && !axis.review_note && <p class="notebook-note">{info.note}</p>}
    {info.reproducibility && <section class="reproduction-coverage">
      <h2>What can be reproduced</h2>
      <p class="coverage-summary">{info.reproducibility.end_to_end
        ? "All five stages are covered by the retained evidence."
        : "Reproduction has documented limits; coverage is listed below."}</p>
      <ol>{info.reproducibility.stages.map((stage) => <li data-stage={stage.id}>
        <strong>{stage.label}</strong><span class="stage-status">{stage.status.replaceAll("_", " ")}</span>
        <p>{stage.detail}</p>
      </li>)}</ol>
      {info.reproducibility.missing.length > 0 && <><h3>Limits and missing inputs</h3>
        <ul>{info.reproducibility.missing.map((item) => <li>{item}</li>)}</ul></>}
      <p>Successful execution verifies the supplied analysis runs; it does not certify the scientific conclusion.</p>
    </section>}
    {visible.map((cell) => (
      <section class="notebook-cell">
        {cell.cell_type === "markdown" ? (
          <div class="notebook-narrative" set:html={micromark(textOf(cell.source).replace(/^# /gm, "## "))} />
        ) : cell.metadata.spectra_role === "plot" ? (
          <details class="plot-code"><summary>Plotting code</summary><pre><code>{textOf(cell.source)}</code></pre></details>
        ) : (
          <><h2>{cell.metadata.title || "Analysis code"}</h2><pre><code>{textOf(cell.source)}</code></pre></>
        )}
        {cell.outputs?.map((out) => {
          const data = out.data;
          const chart = data?.["image/png"];
          const table = data?.["application/vnd.spectra.table+json"];
          if (chart) return <img class="notebook-chart" src={"data:image/png;base64,"+chart} alt={`${axis.name}. ${axis.result}`} />;
          if (table) return <div class="table-scroll"><table><thead><tr>{table.headers.map((h) => <th scope="col">{h}</th>)}</tr></thead><tbody>{table.rows.map((row) => <tr>{row.map((v) => <td>{v}</td>)}</tr>)}</tbody></table></div>;
          const output = textOf(out.text || data?.["text/plain"]);
          return output && <pre class="notebook-output">{output}</pre>;
        })}
      </section>
    ))}
    {script && <details class="plot-code audit-script"><summary>Audit script · {script.metadata.filename}</summary><pre><code>{scriptText}</code></pre></details>}
  </div>
</Layout>
