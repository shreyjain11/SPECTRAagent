---
import Layout from "../../components/RegistryLayout.astro";
import { models, investigations, modelAudits } from "../../lib/paper-registry";
---

<Layout title="Audit registry" description="Read the questions, methods and findings from AutoSPECTRA audits.">
  <div class="registry-intro">
    <h1>Audit registry</h1>
    <p>See what each audit tested, how it tested it, and what the results support.</p>
  </div>
  <div class="sectionline">
    <h2>Browse by model</h2>
    <span>{models.length} models · {investigations.length} investigations</span>
  </div>
  <div class="models">
    {models.map((model) => (
      <a class="model-link" href={`/registry/${model.slug}/`}>
        <span class="model-field">{model.field}</span>
        <h2>{model.name}</h2>
        <p>{model.description}</p>
        <span class="model-count">{modelAudits(model.name).length} investigations <span aria-hidden="true">→</span></span>
      </a>
    ))}
  </div>
  <div class="registry-downloads">
    <a href="/registry/audits.json">Download audit records</a>
    <a href="https://spectra.yashaektefaie.com/api/models">Browse other models ↗</a>
  </div>
</Layout>
